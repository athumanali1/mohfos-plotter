# AI API Configuration (Gemini preferred)
# Get a Gemini API key: https://ai.google.dev
GEMINI_API_KEY=AIzaSyDBQzzwTFFN1Wk176E0Y0W2AZC5jSv2sz0
# Example format (no quotes):
# GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-1.5-flash

# Optional fallback (OpenAI). Leave empty if not using OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Or use other AI service (optional)
ANTHROPIC_API_KEY=

# Server Configuration
PORT=3001
NODE_ENV=development

# Arduino/Device Connectivity
# Choose one of the following setups:
# 1) PC Serial (USB/BT COM): set ARDUINO_PORT to your COM port and BAUD_RATE
# 2) Android Bluetooth (HC-05) direct from phone: leave ARDUINO_PORT empty

# Example for Windows serial: ARDUINO_PORT=COM3
# Example for Linux serial:   ARDUINO_PORT=/dev/ttyUSB0
# Example for macOS serial:   ARDUINO_PORT=/dev/tty.usbmodem1411
ARDUINO_PORT=
BAUD_RATE=9600
